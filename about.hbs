  <title>Win Startup Manager — Third-party licenses</title>
  <style>
    :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
    body { max-width: 920px; margin: 0 auto; padding: 2rem; line-height: 1.5; }
    h1, h2, h3 { line-height: 1.2; }
